[global]
    monitor = 0
    follow = mouse
    width = 360
    origin = top-right
    offset = 18x60
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4
    indicate_hidden = yes
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    gap_size = 6
    separator_color = frame
    sort = yes
    font = JetBrainsMono Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 8
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e222a"
    foreground = "#d9e0ee"
    frame_color = "#565c64"
    highlight = "#989cfa"
    timeout = 4

[urgency_normal]
    background = "#1e222a"
    foreground = "#d9e0ee"
    frame_color = "#989cfa"
    highlight = "#989cfa"
    timeout = 6

[urgency_critical]
    background = "#1e222a"
    foreground = "#d9e0ee"
    frame_color = "#d35f5e"
    highlight = "#d35f5e"
    timeout = 0
